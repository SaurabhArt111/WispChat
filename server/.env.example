PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/wispchat
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set this to the mounted persistent-disk directory in production.
# Render example: UPLOAD_DIR=/var/data/uploads
# Leave unset for the default server/uploads directory in local development.
# UPLOAD_DIR=/var/data/uploads

# --- WebRTC calls (optional but strongly recommended in production) ---
# Without a TURN relay, calls between people on strict NATs / mobile data /
# corporate networks can connect but show no video or play no audio.
# Option A: coturn with `use-auth-secret`
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=your-coturn-static-auth-secret
# Option B: static credentials from a provider (Metered, Twilio, Xirsys...)
# TURN_USERNAME=
# TURN_CREDENTIAL=
